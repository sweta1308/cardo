# Postgres connection string (Neon, Supabase, Render Postgres, …).
# Use the pooled connection string in production.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign auth tokens. Generate with: openssl rand -base64 32
JWT_SECRET="replace-me"

# Origin(s) allowed to call this API, comma-separated.
# Defaults to http://localhost:5173 when unset.
CLIENT_ORIGIN="https://your-app.vercel.app"

# Optional: the platform normally sets this for you.
# PORT=3000
